{{!
    @template mod_aisoftskills/view

    Activity home: the workplace, the career level, skills, the learner's results and the start button.
    The scene player replaces the home when the learner starts.

    Example context (json):
    {
        "uniqid": "ss-1", "config": "{}", "ready": true, "canmanage": false, "canattempt": true, "canstart": true,
        "starts": [{"mode": "practice", "label": "Practise", "intro": "", "primary": false}, {"mode": "test", "label": "Take the test", "intro": "", "primary": true}],
        "showmode": true, "nomore": false, "industry": "Office", "levelname": "Manager",
        "leveldesc": "Leads a team: performance, workload and conflict.", "language": "English",
        "ladder": [{"key": "worker", "name": "Worker", "number": 1, "current": false, "below": true},
            {"key": "manager", "name": "Manager", "number": 3, "current": true, "below": false}],
        "skills": ["Motivating others"], "hasskills": true, "scenes": 8, "bestscore": 75, "hasbest": true,
        "history": [{"number": 1, "score": 75, "mode": "Test", "date": "27/09/26, 10:00"}], "hashistory": true, "attemptsinfo": "",
        "setupurl": "#", "reporturl": "#", "dir": "ltr", "contentlang": "en"
    }
}}
<div id="{{uniqid}}" class="ss-app" data-config="{{config}}">
    <div class="ss-home" data-region="home">
        <section class="ss-hero">
            <div class="ss-hero-main">
                <p class="ss-eyebrow">{{industry}}</p>
                <h3 class="ss-hero-title">{{#str}} herotitle, mod_aisoftskills, {{levelname}} {{/str}}</h3>
                <p class="ss-hero-desc">{{leveldesc}}</p>
                <ul class="ss-facts">
                    <li><span>{{#str}} scenesword, mod_aisoftskills {{/str}}</span><strong>{{scenes}}</strong></li>
                    <li><span>{{#str}} contentlang, mod_aisoftskills {{/str}}</span><strong>{{language}}</strong></li>
                    {{#hasbest}}<li><span>{{#str}} bestscore, mod_aisoftskills {{/str}}</span><strong>{{bestscore}}%</strong></li>{{/hasbest}}
                </ul>
                {{#hasskills}}
                <div class="ss-skillchips" dir="{{dir}}" lang="{{contentlang}}">
                    {{#skills}}<span class="ss-skillchip">{{.}}</span>{{/skills}}
                </div>
                {{/hasskills}}
                <div class="ss-hero-actions">
                    {{#starts.0}}
                    <div class="ss-startmodes">
                        {{#starts}}
                        <div class="ss-startmode">
                            <button type="button" class="ss-btn {{#primary}}ss-btn-primary{{/primary}}{{^primary}}ss-btn-ghost{{/primary}} ss-btn-lg" data-action="start" data-mode="{{mode}}">{{label}}</button>
                            {{#intro}}<p class="ss-mini mb-0">{{.}}</p>{{/intro}}
                        </div>
                        {{/starts}}
                    </div>
                    {{/starts.0}}
                    {{#nomore}}<p class="ss-note">{{#str}} nomoreattempts, mod_aisoftskills {{/str}}</p>{{/nomore}}
                    {{^ready}}<p class="ss-note">{{#canmanage}}{{#str}} notready_manager, mod_aisoftskills {{/str}}{{/canmanage}}{{^canmanage}}{{#str}} notready_student, mod_aisoftskills {{/str}}{{/canmanage}}</p>{{/ready}}
                    {{#attemptsinfo}}<p class="ss-note">{{.}}</p>{{/attemptsinfo}}
                </div>
            </div>
            <ol class="ss-ladder" aria-label="{{#str}} careerladder, mod_aisoftskills {{/str}}">
                {{#ladder}}
                <li class="ss-rung ss-rung-{{key}}{{#current}} is-current{{/current}}{{#below}} is-below{{/below}}"{{#current}} aria-current="step"{{/current}}>
                    <span class="ss-rung-num">{{number}}</span><span class="ss-rung-name">{{name}}</span>
                </li>
                {{/ladder}}
            </ol>
        </section>
        {{#hashistory}}
        <section class="ss-panel">
            <h4 class="ss-panel-title">{{#str}} yourattempts, mod_aisoftskills {{/str}}</h4>
            <table class="table table-sm ss-table">
                <thead><tr><th scope="col">{{#str}} attempt, mod_aisoftskills {{/str}}</th>{{#showmode}}<th scope="col">{{#str}} col_mode, mod_aisoftskills {{/str}}</th>{{/showmode}}<th scope="col">{{#str}} score, mod_aisoftskills {{/str}}</th><th scope="col">{{#str}} date {{/str}}</th></tr></thead>
                <tbody>{{#history}}<tr><td>{{number}}</td>{{#showmode}}<td>{{mode}}</td>{{/showmode}}<td>{{score}}%</td><td>{{date}}</td></tr>{{/history}}</tbody>
            </table>
        </section>
        {{/hashistory}}
        {{#canmanage}}
        <nav class="ss-teacherbar" aria-label="{{#str}} teachertools, mod_aisoftskills {{/str}}">
            <a class="ss-btn ss-btn-ghost ss-btn-sm" href="{{setupurl}}">{{#str}} setup_title, mod_aisoftskills {{/str}}</a>
            {{#reporturl}}<a class="ss-btn ss-btn-ghost ss-btn-sm" href="{{reporturl}}">{{#str}} reports, mod_aisoftskills {{/str}}</a>{{/reporturl}}
        </nav>
        {{/canmanage}}
    </div>
    <div class="ss-player" data-region="player" dir="{{dir}}" lang="{{contentlang}}" hidden></div>
    <div class="ss-live visually-hidden sr-only" aria-live="polite" data-region="live"></div>
</div>
