{{!
    @template mod_aisoftskills/consequence

    What happened after the learner's choice: a workplace indicator gauge that moves, then cards for what happened, why,
    and (after a poorer choice) the better response. Each sentence is its own paragraph.

    Example context (json):
    {
        "best": true, "headline": "Great choice!", "kpiname": "Motivation", "before": 50, "after": 70,
        "deltatext": "+20", "up": true,
        "consequencelines": ["The team relaxes.", "They ask for the two things they need."],
        "reasonlines": ["Offering help shows trust and removes blockers."], "better": "", "betterreasonlines": [],
        "canretry": false, "last": false, "hasvoice": true
    }
}}
<div class="ss-dialog-backdrop" data-region="consequence">
    <div class="ss-dialog ss-consequence {{#best}}is-best{{/best}}{{^best}}is-poor{{/best}}" role="dialog" aria-modal="true" aria-labelledby="ss-consequence-title">
        <div class="ss-consequence-head">
            <span class="ss-consequence-icon" aria-hidden="true">
                {{#best}}<svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{/best}}
                {{^best}}<svg viewBox="0 0 24 24"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/></svg>{{/best}}
            </span>
            <h3 id="ss-consequence-title" class="ss-consequence-title">{{headline}}</h3>
            {{#hasvoice}}
            <button type="button" class="ss-listen ss-listen-sm" data-action="listenfeedback" aria-pressed="false">
                <svg class="ss-listen-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                <svg class="ss-listen-stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                <span class="ss-listen-label">{{#str}} listen_scene, mod_aisoftskills {{/str}}</span>
            </button>
            {{/hasvoice}}
        </div>
        <div class="ss-consequence-body">
            <div class="ss-gauge" data-region="gauge" data-before="{{before}}" data-after="{{after}}" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{after}}" aria-label="{{kpiname}}">
                <svg viewBox="0 0 200 120" aria-hidden="true">
                    <path class="ss-gauge-track" d="M20 110 A80 80 0 0 1 180 110"/>
                    <path class="ss-gauge-fill" d="M20 110 A80 80 0 0 1 180 110" pathLength="100"/>
                    <line class="ss-gauge-needle" x1="100" y1="110" x2="100" y2="42"/>
                    <circle class="ss-gauge-hub" cx="100" cy="110" r="7"/>
                </svg>
                <div class="ss-gauge-read"><strong data-region="gaugevalue">{{before}}</strong><span>{{kpiname}}</span></div>
                <span class="ss-delta {{#up}}is-up{{/up}}{{^up}}is-down{{/up}}">{{deltatext}} {{kpiname}}</span>
            </div>
            <div class="ss-consequence-text">
                {{#consequencelines.0}}
                <section class="ss-fbcard ss-fbcard-what" data-part="consequence">
                    <h4 class="ss-fbcard-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{{#str}} fb_whathappened, mod_aisoftskills {{/str}}</h4>
                    {{#consequencelines}}<p dir="auto">{{.}}</p>{{/consequencelines}}
                </section>
                {{/consequencelines.0}}
                {{#reasonlines.0}}
                <section class="ss-fbcard ss-fbcard-why" data-part="reason">
                    <h4 class="ss-fbcard-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 00-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0012 3z"/></svg>{{#best}}{{#str}} fb_whyworks, mod_aisoftskills {{/str}}{{/best}}{{^best}}{{#str}} fb_whyfalls, mod_aisoftskills {{/str}}{{/best}}</h4>
                    {{#reasonlines}}<p dir="auto">{{.}}</p>{{/reasonlines}}
                </section>
                {{/reasonlines.0}}
                {{#better}}
                <section class="ss-fbcard ss-better">
                    <h4 class="ss-fbcard-title ss-better-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{#str}} betterresponse, mod_aisoftskills {{/str}}</h4>
                    <p class="ss-better-text" dir="auto">“{{better}}”</p>
                    {{#betterreasonlines}}<p dir="auto">{{.}}</p>{{/betterreasonlines}}
                </section>
                {{/better}}
            </div>
        </div>
        <div class="ss-consequence-actions">
            {{#canretry}}<button type="button" class="ss-btn ss-btn-primary" data-action="retry">{{#str}} tryagain, mod_aisoftskills {{/str}}</button>{{/canretry}}
            {{^canretry}}
            <button type="button" class="ss-btn ss-btn-primary" data-action="continue">
                {{#last}}{{#str}} seeresults, mod_aisoftskills {{/str}}{{/last}}{{^last}}{{#str}} nextscene, mod_aisoftskills {{/str}}{{/last}}
            </button>
            {{/canretry}}
        </div>
    </div>
</div>
