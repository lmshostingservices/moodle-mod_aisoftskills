{{!
    @template mod_aisoftskills/kpi_chip

    A small workplace indicator meter.

    Example context (json):
    {"kpi": "morale", "name": "Morale", "value": 62, "start": 50, "tone": "amber", "tonename": "amber"}
}}
<div class="ss-kpichip is-{{tone}}" data-kpi="{{kpi}}" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{value}}" aria-valuetext="{{value}}, {{tonename}}" aria-label="{{name}}">
    <span class="ss-kpichip-name">{{name}}</span>
    <span class="ss-kpichip-bar"><span style="width: {{value}}%;"></span></span>
    <span class="ss-kpichip-value">{{value}}</span>
</div>
