{{!
    @template mod_aisoftskills/dialog

    Small in-player confirmation dialog.

    Example context (json):
    {"message": "Submit with empty places?", "yes": "Submit", "no": "Go back"}
}}
<div class="ss-overlay">
    <div class="ss-dialog" role="alertdialog" aria-modal="true">
        <p>{{message}}</p>
        <div class="ss-dialog-actions">
            <button type="button" class="ss-btn ss-btn-ghost" data-action="no">{{no}}</button>
            <button type="button" class="ss-btn ss-btn-primary" data-action="yes">{{yes}}</button>
        </div>
    </div>
</div>
