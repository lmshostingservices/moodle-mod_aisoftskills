{{!
    @template mod_aisoftskills/builder_review

    Review of a lesson draft before the scenes are created.

    Example context (json):
    {
        "count": 1,
        "scenes": [{"index": 0, "skill": "Motivation", "title": "Behind on the weekly target", "context": "It is Thursday.",
            "question": "What do you say?",
            "options": [{"letter": "A", "text": "Is there anything I can get you to help you reach your goals faster?",
                "best": true, "kpiname": "Motivation", "delta": "+20"},
                {"letter": "B", "text": "Hurry up!", "best": false, "worst": false, "kpiname": "Morale", "delta": "-20"}]}]
    }
}}
<div class="ss-panel">
    <h4>{{#str}} review_title, mod_aisoftskills, {{count}} {{/str}}</h4>
    <p class="ss-mini">{{#str}} review_help, mod_aisoftskills {{/str}}</p>
    <div class="ss-draftgrid">
        {{#scenes}}
        <label class="ss-draft">
            <span class="ss-draft-head">
                <input type="checkbox" data-scene="{{index}}" checked>
                <span>
                    {{#skill}}<span class="ss-draft-sit" dir="auto">{{skill}}</span>{{/skill}}
                    <strong dir="auto">{{title}}</strong>
                </span>
            </span>
            {{#context}}<span class="ss-draft-context" dir="auto">{{context}}</span>{{/context}}
            {{#question}}<span class="ss-draft-context" dir="auto"><b>{{question}}</b></span>{{/question}}
            <span class="ss-draft-phrases">
                {{#options}}
                <span class="ss-draft-phrase {{#best}}is-best{{/best}}{{^best}}is-distractor{{/best}}">
                    <b>{{letter}}</b> <span dir="auto">{{text}}</span>
                    <span class="ss-draft-kpi">{{#best}}{{#str}} review_better, mod_aisoftskills {{/str}} · {{/best}}{{#worst}}{{#str}} review_worst, mod_aisoftskills {{/str}} · {{/worst}}{{kpiname}} {{delta}}</span>
                </span>
                {{/options}}
            </span>
        </label>
        {{/scenes}}
    </div>
    <div class="ss-wizard-actions">
        <button type="button" class="ss-btn ss-btn-primary" data-action="create">{{#str}} review_create, mod_aisoftskills {{/str}}</button>
    </div>
</div>
