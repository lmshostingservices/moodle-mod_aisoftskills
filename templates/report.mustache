{{!
    @template mod_aisoftskills/report

    Teacher reports: learners, scenes and attempts.

    Example context (json):
    {
        "tabs": [{"name": "Learners", "url": "#", "active": true}], "learners": true, "scenes": false, "attempts": false,
        "groupselector": "", "identityheaders": [{"name": "Email address"}], "hasrows": true, "paging": "", "downloads": "",
        "rows": [{"fullname": "Ana Silva", "profileurl": "#", "identity": [{"value": "ana@example.com"}], "attempts": 1,
            "inprogress": false, "best": "75%", "grade": "75%", "lastfinish": "1/10/26"}]
    }
}}
<div id="ss-report" class="ss-report">
    <nav class="ss-tabs" aria-label="{{#str}} reports, mod_aisoftskills {{/str}}">
        {{#tabs}}<a class="ss-tab{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{name}}</a>{{/tabs}}
    </nav>
    {{{groupselector}}}

    {{#learners}}
    <p class="ss-mini">{{#str}} report_learners_help, mod_aisoftskills {{/str}}</p>
    {{#hasrows}}
    <div class="table-responsive" tabindex="0" role="region" aria-label="{{#str}} report_learners, mod_aisoftskills {{/str}}">
    <table class="table table-sm ss-table">
        <thead><tr>
            <th scope="col">{{#str}} fullname {{/str}}</th>
            {{#identityheaders}}<th scope="col">{{name}}</th>{{/identityheaders}}
            <th scope="col">{{#str}} col_attempts, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_bestscore, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_grade, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_lastfinish, mod_aisoftskills {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#rows}}
        <tr>
            <td><a href="{{profileurl}}">{{fullname}}</a></td>
            {{#identity}}<td>{{value}}</td>{{/identity}}
            <td>{{attempts}}{{#inprogress}} <span class="ss-mini">({{#str}} state_inprogress, mod_aisoftskills {{/str}})</span>{{/inprogress}}</td>
            <td>{{best}}</td>
            <td>{{grade}}</td>
            <td>{{lastfinish}}</td>
        </tr>
        {{/rows}}
        </tbody>
    </table>
    </div>
    {{{paging}}}
    {{{downloads}}}
    {{/hasrows}}
    {{^hasrows}}<p class="ss-note">{{#str}} nolearners, mod_aisoftskills {{/str}}</p>{{/hasrows}}
    {{/learners}}

    {{#scenes}}
    <p class="ss-mini">{{#str}} report_scenes_help, mod_aisoftskills {{/str}}</p>
    {{#hasrows}}
    <div class="table-responsive" tabindex="0" role="region" aria-label="{{#str}} report_scenes, mod_aisoftskills {{/str}}">
    <table class="table table-sm ss-table">
        <thead><tr>
            <th scope="col">#</th>
            <th scope="col">{{#str}} col_scene, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_skill, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_answers, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_bestfirst, mod_aisoftskills {{/str}}</th>
            <th scope="col">{{#str}} col_tries, mod_aisoftskills {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#rows}}
        <tr class="{{#hard}}ss-hardrow{{/hard}}">
            <td>{{number}}</td><td dir="auto">{{title}}</td><td dir="auto">{{skill}}</td><td>{{answers}}</td>
            <td>{{bestfirst}}</td><td>{{tries}}</td>
        </tr>
        {{/rows}}
        </tbody>
    </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}<p class="ss-note">{{#str}} noscenesyet, mod_aisoftskills {{/str}}</p>{{/hasrows}}
    {{/scenes}}

    {{#attempts}}
    {{#hasrows}}
    <form method="post" action="{{actionurl}}" data-region="attemptsform">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="table-responsive" tabindex="0" role="region" aria-label="{{#str}} report_attempts, mod_aisoftskills {{/str}}">
        <table class="table table-sm ss-table">
            <thead><tr>
                {{#canmanage}}<th scope="col"><input type="checkbox" data-action="selectall" aria-label="{{#str}} selectall {{/str}}"></th>{{/canmanage}}
                <th scope="col">{{#str}} fullname {{/str}}</th>
                {{#identityheaders}}<th scope="col">{{name}}</th>{{/identityheaders}}
                <th scope="col">{{#str}} col_attempt, mod_aisoftskills {{/str}}</th>
                <th scope="col">{{#str}} col_mode, mod_aisoftskills {{/str}}</th>
                <th scope="col">{{#str}} col_state, mod_aisoftskills {{/str}}</th>
                <th scope="col">{{#str}} col_started, mod_aisoftskills {{/str}}</th>
                <th scope="col">{{#str}} col_duration, mod_aisoftskills {{/str}}</th>
                <th scope="col">{{#str}} col_score, mod_aisoftskills {{/str}}</th>
            </tr></thead>
            <tbody>
            {{#rows}}
            <tr>
                {{#canmanage}}<td><input type="checkbox" name="attemptids[]" value="{{id}}" aria-label="{{#str}} select {{/str}} {{fullname}}"></td>{{/canmanage}}
                <td>{{fullname}}</td>
                {{#identity}}<td>{{value}}</td>{{/identity}}
                <td>{{attempt}}</td><td>{{mode}}</td><td>{{state}}</td><td>{{started}}</td><td>{{duration}}</td><td>{{score}}</td>
            </tr>
            {{/rows}}
            </tbody>
        </table>
        </div>
        {{#canmanage}}
        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-danger" name="action" value="delete" data-action="deleteselected">{{#str}} deleteselected, mod_aisoftskills {{/str}}</button>
            <button type="submit" class="btn btn-secondary" name="action" value="regrade">{{#str}} regradeall, mod_aisoftskills {{/str}}</button>
        </div>
        {{/canmanage}}
    </form>
    {{{paging}}}
    {{{downloads}}}
    {{/hasrows}}
    {{^hasrows}}<p class="ss-note">{{#str}} noattempts, mod_aisoftskills {{/str}}</p>{{/hasrows}}
    {{/attempts}}
</div>
