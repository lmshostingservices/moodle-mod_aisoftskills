{{!
    @template mod_aisoftskills/scenes

    Set-up step 6 (pictures) or 7 (check each scene), one card per scene in playing order.

    Example context (json):
    {
        "bar": {"current": 6, "total": 8, "steps": [{"number": 6, "name": "Pictures", "done": false, "current": true, "dot": 0}]},
        "pictures": true, "check": false,
        "hasscenes": true, "count": 1, "industry": "Retail",
        "cmid": 1, "requests": [], "canai": true, "aioff": false, "missingcount": 1, "missingids": "1",
        "missingcredits": 5, "imagecredits": 5,
        "cards": [{"id": 1, "number": 1, "title": "Behind on the target", "skill": "Motivation", "image": "", "noimage": true,
            "responsesok": true, "canai": true, "imagecredits": 5,
            "editurl": "#", "replaceurl": "#", "deleteurl": "#", "upurl": null, "downurl": null}],
        "nav": {"backurl": "#", "backlabel": "Back", "nexturl": "#", "nextlabel": "Next: Check the scenes", "blocked": "1 scene still needs a picture."}
    }
}}
<div id="ss-scenes" class="ss-wizard ss-slides">
    <div class="ss-setup-head">
        <h2 class="h3">{{#str}} setup_title, mod_aisoftskills {{/str}}</h2>
        {{#bar}}{{> mod_aisoftskills/setup_steps}}{{/bar}}
    </div>

    {{#pictures}}
    <div class="ss-wstep">
        <h3 class="ss-wstep-title">{{#str}} pictures_title, mod_aisoftskills {{/str}}</h3>
        <p class="ss-mini">{{#str}} pictures_intro, mod_aisoftskills, {{imagecredits}} {{/str}}</p>
        {{#canai}}{{#missingcount}}
        <button type="button" class="ss-btn ss-btn-primary" data-action="genall" data-scenes="{{missingids}}" data-credits="{{imagecredits}}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>
            <span>{{#str}} genall_button, mod_aisoftskills, { "count": {{missingcount}}, "credits": {{missingcredits}} } {{/str}}</span>
        </button>
        {{/missingcount}}
        {{^missingcount}}<p class="ss-ok mb-0">{{#str}} pictures_alldone, mod_aisoftskills {{/str}}</p>{{/missingcount}}
        {{/canai}}
        {{#aioff}}<p class="ss-note mb-0">{{#str}} pictures_notconnected, mod_aisoftskills {{/str}}</p>{{/aioff}}
        {{> mod_aisoftskills/aireq_list}}
    </div>
    {{/pictures}}

    {{#check}}
    <div class="ss-wstep">
        <h3 class="ss-wstep-title">{{#str}} check_title, mod_aisoftskills {{/str}}</h3>
        <p class="ss-mini mb-0">{{#str}} check_intro, mod_aisoftskills {{/str}}</p>
    </div>
    {{/check}}

    {{^hasscenes}}<p class="ss-note">{{#str}} noscenesyet, mod_aisoftskills {{/str}}</p>{{/hasscenes}}
    <div class="ss-slides-grid">
        {{#cards}}
        <div class="ss-slidecard" data-scene="{{id}}">
            <div class="ss-slidecard-thumb">
                {{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}
                {{#noimage}}<span class="ss-slidecard-noimage">{{#str}} noimageyet, mod_aisoftskills {{/str}}</span>{{/noimage}}
                <span class="ss-slidecard-no">{{#str}} scenex, mod_aisoftskills, {{number}} {{/str}}</span>
            </div>
            <div class="ss-slidecard-body">
                {{#skill}}<span class="ss-slidecard-skill" dir="auto">{{skill}}</span>{{/skill}}
                <h3 class="ss-slidecard-title" dir="auto">{{title}}</h3>
                {{#pictures}}
                <div class="ss-slidecard-meta {{#noimage}}is-warn{{/noimage}}">
                    {{#noimage}}{{#str}} sceneneedsimage, mod_aisoftskills {{/str}}{{/noimage}}{{^noimage}}{{#str}} scenehasimage, mod_aisoftskills {{/str}}{{/noimage}}
                </div>
                {{#canai}}
                <button type="button" class="ss-btn {{#noimage}}ss-btn-primary{{/noimage}}{{^noimage}}ss-btn-ghost{{/noimage}} ss-btn-sm w-100" data-action="genimage" data-scene="{{id}}" data-replace="{{^noimage}}1{{/noimage}}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>
                    <span>{{#noimage}}{{#str}} generateimage, mod_aisoftskills, {{imagecredits}} {{/str}}{{/noimage}}{{^noimage}}{{#str}} regenerateimage, mod_aisoftskills, {{imagecredits}} {{/str}}{{/noimage}}</span>
                </button>
                {{/canai}}
                <a class="ss-btn ss-btn-ghost ss-btn-sm w-100 mt-2" href="{{replaceurl}}">{{#str}} uploadownimage, mod_aisoftskills {{/str}}</a>
                {{/pictures}}
                {{#check}}
                <div class="ss-slidecard-meta {{^responsesok}}is-warn{{/responsesok}}">
                    {{#responsesok}}{{#str}} sceneresponsesok, mod_aisoftskills {{/str}}{{/responsesok}}{{^responsesok}}{{#str}} sceneneedsresponses, mod_aisoftskills {{/str}}{{/responsesok}}
                </div>
                <div class="ss-slidecard-actions">
                    <a class="ss-btn {{^responsesok}}ss-btn-primary{{/responsesok}}{{#responsesok}}ss-btn-ghost{{/responsesok}} ss-btn-sm" href="{{editurl}}">{{#responsesok}}{{#str}} editscene, mod_aisoftskills {{/str}}{{/responsesok}}{{^responsesok}}{{#str}} addresponses, mod_aisoftskills {{/str}}{{/responsesok}}</a>
                    {{#upurl}}<a class="ss-iconbtn" href="{{upurl}}" title="{{#str}} moveleft, mod_aisoftskills {{/str}}" aria-label="{{#str}} moveleft, mod_aisoftskills {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></a>{{/upurl}}
                    {{#downurl}}<a class="ss-iconbtn" href="{{downurl}}" title="{{#str}} moveright, mod_aisoftskills {{/str}}" aria-label="{{#str}} moveright, mod_aisoftskills {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></a>{{/downurl}}
                    <a class="ss-iconbtn" href="{{deleteurl}}" title="{{#str}} delete {{/str}}" aria-label="{{#str}} delete {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg></a>
                </div>
                {{/check}}
            </div>
        </div>
        {{/cards}}
    </div>


    {{> mod_aisoftskills/setup_nav}}
</div>
