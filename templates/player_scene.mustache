{{!
    @template mod_aisoftskills/player_scene

    One workplace moment on one picture, with the two responses the learner chooses between.

    Example context (json):
    {
        "sceneid": 1, "number": 1, "total": 8, "title": "The deadline is slipping", "skill": "Motivating others",
        "context": "The team is behind schedule and tired.", "speaker": "You, the team leader",
        "dialogue": [{"speaker": "Sam", "line": "We will never make Friday."}, {"speaker": "Ana", "line": "Not like this."}],
        "question": "What do you say?", "image": "https://example.com/scene.png",
        "options": [{"id": 11, "letter": "A", "text": "Is there anything I can get you to help you reach the goal faster?"},
            {"id": 12, "letter": "B", "text": "Hurry up, all of you!"}]
    }
}}
<section class="ss-scene" data-sceneid="{{sceneid}}" aria-labelledby="ss-scene-title-{{sceneid}}">
    <div class="ss-scene-head">
        {{#skill}}<span class="ss-skillchip" dir="auto">{{skill}}</span>{{/skill}}
        <h3 class="ss-scene-title" dir="auto" id="ss-scene-title-{{sceneid}}">{{title}}</h3>
    </div>
    <div class="ss-scene-body">
        <figure class="ss-figure">
            <img src="{{image}}" alt="{{title}}" draggable="false">
            {{#speaker}}<figcaption class="ss-speaker" dir="auto">{{speaker}}</figcaption>{{/speaker}}
        </figure>
        <div class="ss-scene-side">
            {{#context}}<p class="ss-context" dir="auto">{{context}}</p>{{/context}}
            {{#dialogue.0}}
            <div class="ss-dialogue">
                {{#dialogue}}<p class="ss-dialogue-line" dir="auto">{{#speaker}}<strong class="ss-dialogue-speaker">{{speaker}}</strong> {{/speaker}}<span>{{line}}</span></p>{{/dialogue}}
            </div>
            {{/dialogue.0}}
            <p class="ss-question" dir="auto">{{#question}}{{question}}{{/question}}{{^question}}{{#str}} whatdoyousay, mod_aisoftskills {{/str}}{{/question}}</p>
            <div class="ss-options" role="group" aria-label="{{#str}} responses, mod_aisoftskills {{/str}}">
                {{#options}}
                <button type="button" class="ss-option" data-optionid="{{id}}">
                    <span class="ss-option-letter" aria-hidden="true">{{letter}}</span>
                    <span class="ss-option-text" dir="auto">{{text}}</span>
                </button>
                {{/options}}
            </div>
        </div>
    </div>
</section>
