{{!
    @template mod_aisoftskills/aireq_item

    One stored LMS Labs request: what happened and what the teacher can do next.

    Example context (json):
    {
        "id": 3, "operation": "scene", "status": "uncertain", "title": "A scheduling conflict",
        "message": "LMS Labs did not confirm this draft.", "requestid": "abc", "canrecheck": true, "candismiss": true,
        "poll": false, "retryafter": 5, "sceneid": 0, "sceneurl": "", "openscene": false, "timecreated": "Monday"
    }
}}
<div class="ss-aireq is-{{status}}" data-request="{{id}}" data-status="{{status}}" data-operation="{{operation}}" data-scene="{{sceneid}}"{{#poll}} data-poll="1"{{/poll}} data-retryafter="{{retryafter}}">
    <div class="ss-aireq-head">
        <strong class="ss-aireq-title" dir="auto">{{title}}</strong>
        <span class="ss-mini">{{timecreated}}</span>
    </div>
    <p class="ss-aireq-message" role="status">{{message}}</p>
    <div class="ss-aireq-actions">
        {{#openscene}}<a class="ss-btn ss-btn-primary ss-btn-sm" href="{{sceneurl}}">{{#str}} aireq_openscene, mod_aisoftskills {{/str}}</a>{{/openscene}}
        {{#canrecheck}}<button type="button" class="ss-btn ss-btn-primary ss-btn-sm" data-action="recheck">{{#str}} aireq_checkagain, mod_aisoftskills {{/str}}</button>{{/canrecheck}}
        {{#candismiss}}<button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="dismiss"{{#canrecheck}} data-confirm="1"{{/canrecheck}}>{{#str}} aireq_dismiss, mod_aisoftskills {{/str}}</button>{{/candismiss}}
    </div>
</div>
