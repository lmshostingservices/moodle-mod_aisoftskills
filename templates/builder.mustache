{{!
    @template mod_aisoftskills/builder

    Set-up steps 1 to 4: workplace, level, skills, language. Back and Next move between them.

    Example context (json):
    {
        "cmid": 1, "action": "#", "sesskey": "abc",
        "bar": {"current": 1, "total": 8, "steps": [{"number": 1, "name": "Workplace", "done": false, "current": true, "dot": 1}]},
        "illustration": true, "photo": false, "customindustry": "",
        "industries": [{"key": "retail", "name": "Retail", "selected": true, "custom": false}],
        "levels": [{"key": "worker", "number": 1, "name": "Worker", "desc": "Doing the job well", "selected": true}],
        "groups": [{"key": "people", "name": "Working with people", "items": [{"key": "empathy", "name": "Empathy", "checked": true}]}],
        "custom": [{"index": 1, "value": "", "hidden": false}],
        "languages": [{"code": "en", "name": "English", "endonym": "English", "showendonym": false, "rtl": false, "selected": true}],
        "scenes": [{"value": 8, "selected": true}]
    }
}}
<form id="ss-wizard" class="ss-wizard" method="post" action="{{action}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="savechoices" value="1">
    <div class="ss-setup-head">
        <h2 class="h3">{{#str}} setup_title, mod_aisoftskills {{/str}}</h2>
        {{#bar}}{{> mod_aisoftskills/setup_steps}}{{/bar}}
    </div>

    <fieldset class="ss-wstep" data-step="1">
        <legend class="ss-wstep-title">{{#str}} q_industry, mod_aisoftskills {{/str}}</legend>
        <p class="ss-mini">{{#str}} q_industry_help, mod_aisoftskills {{/str}}</p>
        <div class="ss-cardgrid">
            {{#industries}}
            <label class="ss-pick">
                <input type="radio" name="industry" value="{{key}}" {{#selected}}checked{{/selected}} required>
                <span class="ss-pick-body"><strong>{{name}}</strong></span>
            </label>
            {{/industries}}
        </div>
        <div class="ss-panel ss-custom" data-region="customindustry">
            <label for="ss-customindustry">{{#str}} customindustry, mod_aisoftskills {{/str}}</label>
            <input type="text" class="ss-input" id="ss-customindustry" name="customindustry" value="{{customindustry}}" maxlength="120" placeholder="{{#str}} customindustry_placeholder, mod_aisoftskills {{/str}}">
        </div>
    </fieldset>

    <fieldset class="ss-wstep" data-step="2">
        <legend class="ss-wstep-title">{{#str}} q_level, mod_aisoftskills {{/str}}</legend>
        <p class="ss-mini">{{#str}} q_level_help, mod_aisoftskills {{/str}}</p>
        <div class="ss-levels">
            {{#levels}}
            <label class="ss-pick ss-level">
                <input type="radio" name="level" value="{{key}}" {{#selected}}checked{{/selected}} required>
                <span class="ss-pick-body">
                    <span class="ss-level-code">{{number}}</span>
                    <strong>{{name}}</strong>
                    <span class="ss-level-desc">{{desc}}</span>
                </span>
            </label>
            {{/levels}}
        </div>
    </fieldset>

    <fieldset class="ss-wstep" data-step="3">
        <legend class="ss-wstep-title">{{#str}} q_skills, mod_aisoftskills {{/str}}</legend>
        <p class="ss-mini">{{#str}} q_skills_help, mod_aisoftskills {{/str}}</p>
        <div class="ss-sitgroups">
            {{#groups}}
            <div class="ss-sitgroup">
                <h3>{{name}}</h3>
                {{#items}}
                <label class="ss-check-row ss-sit"><input type="checkbox" name="skills[]" value="{{key}}" {{#checked}}checked{{/checked}}><span>{{name}}</span></label>
                {{/items}}
            </div>
            {{/groups}}
        </div>
        <div class="ss-panel ss-custom">
            <h3>{{#str}} q_custom, mod_aisoftskills {{/str}}</h3>
            <p class="ss-mini">{{#str}} q_custom_help, mod_aisoftskills {{/str}}</p>
            {{#custom}}
            <input type="text" class="ss-input" name="custom[]" value="{{value}}" maxlength="120" data-custom="{{index}}" aria-label="{{#str}} q_custom, mod_aisoftskills {{/str}} {{index}}" placeholder="{{#str}} q_custom_placeholder, mod_aisoftskills {{/str}}" {{#hidden}}hidden{{/hidden}}>
            {{/custom}}
            <button type="button" class="ss-btn ss-btn-ghost ss-btn-sm" data-action="addcustom">{{#str}} q_custom_add, mod_aisoftskills {{/str}}</button>
        </div>
        <div class="ss-sizes">
            <label>{{#str}} scenecount, mod_aisoftskills {{/str}}
                <select name="scenes" class="custom-select form-select">{{#scenes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/scenes}}</select>
            </label>
            <label>{{#str}} imagestyle, mod_aisoftskills {{/str}}
                <select name="imagestyle" class="custom-select form-select">
                    <option value="illustration" {{#illustration}}selected{{/illustration}}>{{#str}} imagestyle_illustration_name, mod_aisoftskills {{/str}}</option>
                    <option value="photo" {{#photo}}selected{{/photo}}>{{#str}} imagestyle_photo_name, mod_aisoftskills {{/str}}</option>
                </select>
            </label>
        </div>
        <p class="ss-wizard-error" data-region="skillerror" hidden>{{#str}} q_skills_none, mod_aisoftskills {{/str}}</p>
    </fieldset>

    <fieldset class="ss-wstep" data-step="4">
        <legend class="ss-wstep-title">{{#str}} q_language, mod_aisoftskills {{/str}}</legend>
        <p class="ss-mini">{{#str}} q_language_help, mod_aisoftskills {{/str}}</p>
        <div class="ss-cardgrid">
            {{#languages}}
            <label class="ss-pick">
                <input type="radio" name="contentlang" value="{{code}}" {{#selected}}checked{{/selected}} required>
                <span class="ss-pick-body">
                    <strong>{{name}}</strong>
                    {{#showendonym}}<span class="ss-pick-endonym" lang="{{code}}" {{#rtl}}dir="rtl"{{/rtl}}>{{endonym}}</span>{{/showendonym}}
                </span>
            </label>
            {{/languages}}
        </div>
    </fieldset>

    <div class="ss-wizard-actions">
        <button type="button" class="ss-btn ss-btn-ghost" data-action="prev">{{#str}} previous, mod_aisoftskills {{/str}}</button>
        <button type="button" class="ss-btn ss-btn-primary" data-action="nextstep">{{#str}} next, mod_aisoftskills {{/str}}</button>
        <button type="submit" class="ss-btn ss-btn-primary" data-action="save">{{#str}} builder_save, mod_aisoftskills {{/str}}</button>
    </div>
</form>
